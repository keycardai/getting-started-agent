# Written by `keycard new agent`. Copy to .env and fill in if you set the agent up by hand.

# Your Keycard zone, e.g. https://<zone-id>.keycard.cloud
KEYCARD_ZONE_URL=
# The agent's application credentials
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=
# The agent's own resource: the audience of the token it gets as itself
KEYCARD_RESOURCE_URL=

# Optional: the PagerDuty resource the agent reads with an exchanged token (no gateway).
# Defaults to https://api.pagerduty.com
KEYCARD_DEPENDENCY_URL=

# Optional: the zone resource that holds the vaulted Anthropic API key.
# Defaults to https://api.anthropic.com
KEYCARD_ANTHROPIC_URL=
# Optional, defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
