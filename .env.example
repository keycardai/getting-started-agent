# Written by `keycard new agent`. Copy to .env and fill in if you set the agent up by hand.

# Your Keycard zone, e.g. https://<zone-id>.keycard.cloud
KEYCARD_ZONE_URL=
# The agent's application credentials
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=
# The agent's own resource: the audience of the token it gets as itself
KEYCARD_RESOURCE_URL=

# The dependency the agent calls with an exchanged token (no gateway)
KEYCARD_DEPENDENCY_URL=
# Optional: the URL to GET with the exchanged token. Defaults to KEYCARD_DEPENDENCY_URL.
DEPENDENCY_REQUEST_URL=
